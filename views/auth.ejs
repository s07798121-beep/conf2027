<%- include('header') %>

<div class="row justify-content-center">
  <div class="col-md-6 col-12">
    <div class="card">
      <div class="card-body">
        <!-- TODO: вывод flash-сообщений --> 

        <ul class="nav nav-tabs mb-3" role="tablist">
          <li class="nav-item" role="presentation">
            <button
              class="nav-link <%= mode === 'register' ? 'active' : '' %>"
              data-bs-toggle="tab"
              data-bs-target="#register-tab"
              type="button"
              role="tab"
            >
              Регистрация
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button
              class="nav-link <%= mode === 'login' ? 'active' : '' %>"
              data-bs-toggle="tab"
              data-bs-target="#login-tab"
              type="button"
              role="tab"
            >
              Вход
            </button>
          </li>
        </ul>

        <div class="tab-content">
          <!-- ТАБ: РЕГИСТРАЦИЯ -->
          <div
            class="tab-pane fade <%= mode === 'register' ? 'show active' : '' %>"
            id="register-tab"
            role="tabpanel"
          >
            <!-- TODO: блок вывода ошибок валидации -->

            <form method="POST" action="/register">
              <div class="mb-3">
                <label class="form-label">Логин</label>
                <input
                  type="text"
                  class="form-control"
                  name="login"
                  placeholder="латиница и цифры, минимум 6 символов"
                  required
                />
                <!-- TODO: value="<%= form.login || '' %>" -->
              </div>

              <div class="mb-3">
                <label class="form-label">Пароль</label>
                <input
                  type="password"
                  class="form-control"
                  name="password"
                  placeholder="минимум 8 символов"
                  required
                />
              </div>

              <div class="mb-3">
                <label class="form-label">ФИО</label>
                <input
                  type="text"
                  class="form-control"
                  name="fio"
                  placeholder="Иванов Иван Иванович"
                  required
                />
                <!-- TODO: value="<%= form.fio || '' %>" -->
              </div>

              <div class="mb-3">
                <label class="form-label">Телефон</label>
                <input
                  type="text"
                  class="form-control"
                  name="phone"
                  placeholder="8(999)123-45-67"
                  required
                />
                <!-- TODO: value="<%= form.phone || '' %>" -->
              </div>

              <div class="mb-3">
                <label class="form-label">Email</label>
                <input
                  type="email"
                  class="form-control"
                  name="email"
                  placeholder="user@example.com"
                  required
                />
                <!-- TODO: value="<%= form.email || '' %>" -->
              </div>

              <button type="submit" class="btn btn-primary w-100">
                Создать пользователя
              </button>
            </form>

            <p class="mt-3 text-center">
              Уже есть аккаунт?
              <button
                class="btn btn-link p-0"
                data-bs-toggle="tab"
                data-bs-target="#login-tab"
                type="button"
              >
                Войти
              </button>
            </p>
          </div>

          <!-- ТАБ: ВХОД -->
          <div
            class="tab-pane fade <%= mode === 'login' ? 'show active' : '' %>"
            id="login-tab"
            role="tabpanel"
          >
            <!-- TODO: блок вывода ошибки входа -->

            <form method="POST" action="/login">
              <div class="mb-3">
                <label class="form-label">Логин</label>
                <input type="text" class="form-control" name="login" required />
              </div>

              <div class="mb-3">
                <label class="form-label">Пароль</label>
                <input
                  type="password"
                  class="form-control"
                  name="password"
                  required
                />
              </div>

              <button type="submit" class="btn btn-primary w-100">Войти</button>
            </form>

            <p class="mt-3 text-center">
              Еще не зарегистрированы?
              <button
                class="btn btn-link p-0"
                data-bs-toggle="tab"
                data-bs-target="#register-tab"
                type="button"
              >
                Регистрация
              </button>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('footer') %>
